# ---------------------------------------------------------------------------
# Tell — environment. Copy to .env for local use, or set these in your host's
# secret store. Never commit real values; .env is gitignored.
#
# Anything here is a SECRET unless marked public. There are no public keys in
# this app: the browser bundle contains no configuration at all, it reads
# everything it needs from /api/config at runtime.
# ---------------------------------------------------------------------------

# --- core -------------------------------------------------------------------
PORT=4173
# SQLite file. Put it on a mounted volume in production, or it dies with the container.
PROGNOSE_DB=./data/prognose.db
# Public origin, used for payment redirects. Must be https in production.
PUBLIC_BASE_URL=http://localhost:4173
# Session lifetime in days.
SESSION_DAYS=30

# --- branding (public) ------------------------------------------------------
BRAND_NAME=Tell
BRAND_TAGLINE=Was passiert als Nächstes?

# --- payments ---------------------------------------------------------------
# mock = in-app sandbox, no real money. stripe = cards. wise = bank transfer.
PAYMENTS_PROVIDER=mock
# Payouts often need a different rail; falls back to PAYMENTS_PROVIDER.
# PAYOUT_PROVIDER=wise
# HMAC secret for the mock provider's webhooks. Change it before exposing the app.
PAYMENTS_WEBHOOK_SECRET=change-me

# --- stripe (secret) --------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=eur

# --- wise (secret) ----------------------------------------------------------
# WISE_API_TOKEN=...
# WISE_PROFILE_ID=...
# WISE_ENV=sandbox
# WISE_CURRENCY=EUR
# WISE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# WISE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# WISE_ACCOUNT_HOLDER=
# WISE_ACCOUNT_IBAN=
# WISE_ACCOUNT_BIC=
# WISE_ACCOUNT_BANK=

# --- limits -----------------------------------------------------------------
# Per-IP auth attempts per minute. Raise only for load testing.
# PROGNOSE_AUTH_LIMIT=
# Maximum simultaneous live-stream connections.
# STREAM_MAX_CLIENTS=1000
