{
  "name": "prognose",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Polymarket-style prediction market app with an LMSR automated market maker. Zero dependencies.",
  "scripts": {
    "start": "node --no-warnings server/server.js",
    "dev": "node --no-warnings --watch server/server.js",
    "seed": "node --no-warnings server/seed.js",
    "test": "node --no-warnings --test \"test/*.test.js\"",
    "check": "node tools/check.mjs",
    "icons": "node tools/make-icons.mjs",
    "verify": "npm run check && npm test",
    "harness": "node --no-warnings harness/run.mjs",
    "eval": "node --no-warnings harness/run.mjs eval",
    "load": "node --no-warnings harness/run.mjs load",
    "e2e": "node --no-warnings harness/run.mjs e2e",
    "sweep": "node --no-warnings harness/run.mjs sweep"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
